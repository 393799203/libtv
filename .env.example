# LibTV 环境变量配置
# 部署时根据实际情况修改

# 服务器配置 (通过 config.yaml 覆盖，此处仅作 docker-compose 引用)
# 数据库由 postgres 容器提供，config.yaml 中 database.host 应改为 db
# Redis 由 redis 容器提供，config.yaml 中 redis.host 应改为 redis

# Required in Docker/release. Generate a private random value with: openssl rand -hex 32
JWT_SECRET=
# Shared login for these subdomains; other hosts automatically use host-only cookies.
AUTH_COOKIE_DOMAIN=.yunqueai.cloud

# Email verification is required for new registrations. Existing accounts can log in without SMTP.
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=漫蛙
